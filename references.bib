@article{Danielsson_2020,
doi = {10.1088/1748-0221/15/07/C07007},
url = {https://dx.doi.org/10.1088/1748-0221/15/07/C07007},
year = {2020},
month = {jul},
publisher = {},
volume = {15},
number = {07},
pages = {C07007},
author = {Danielsson, H. and Gavrishchuk, O. and Giudici, P. A. and Goudzovski, E. and Kholodenko, S. and Kholodenko, M. and Mannelli, I. and Obraztsov, V. and Sugonyaev, V. and Wanke, R.},
title = {New veto hodoscope ANTI-0 for the NA62 experiment at CERN},
journal = {Journal of Instrumentation},
abstract = {The NA62 experiment is a fixed-target experiment at the CERN   SPS. The main goal of the experiment is to measure the branching   ratio of the ultra-rare kaon decay K+→π+νν̄. The   NA62 detector allows also to study other rare kaon decays and to   search for very weakly coupled particles of MeV-GeV mass-scale. The   new ANTI-0 hodoscope is proposed and designed to veto events with   charged halo particles entering the decay volume. It is now being   assembled at CERN. The detector design, the performance simulation   and the results of measurements with cosmic rays and test beams for   the individual elements are presented. The commissioning and the   first run of data-taking is scheduled for after the end of LS2 long   shutdown (April 2021).}
}

