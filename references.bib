@article{BARDON1958156,
title = {Long-lived neutral K mesons},
journal = {Annals of Physics},
volume = {5},
number = {2},
pages = {156-181},
year = {1958},
issn = {0003-4916},
doi = {https://doi.org/10.1016/0003-4916(58)90048-4},
url = {https://www.sciencedirect.com/science/article/pii/0003491658900484},
author = {M Bardon and K Lande and L.M Lederman and William Chinowsky},
abstract = {The results of a complete analysis of photographs obtained by the Columbia 36-in. magnet cloud chamber in neutral beams of the Brookhaven Cosmotron are presented. A “short-distance” exposure yielded 152 events giving unambiguous proof of the existence of long-lived neutral V-particles, most naturally interpreted as examples of K20 disintegrations. In a subsequent “long-distance” run, 34 events were found, giving a lifetime for K20 of 8.1−2.4+3.2 × 10−8 sec. Decay modes identified were: π±e∓ plus a neutral; π±μ∓ plus a neutral and π+π− plus a neutral. These are most economically interpreted as the neutral counterparts of K+ decay, i.e., π±e∓ν, π±μ∓ν, and π+π−π0. In t case, the first two constitute the bulk of the events, the τ0 mode being ≾15% of the total sample. No evidence is found for 2-body disintegration. Finally, the recent literature on the subject of K20 is briefly reviewed.}
}

